{
  "id": "luckylew23.markmap",
  "name": "%name%",
  "version": "0.2.0",
  "publisher": "luckylew23",
  "author": "luckylew23",
  "license": "MIT",
  "repository": "https://github.com/luckylew23/luckylew23.markmap",
  "icon": "tab.svg",
  "description": "%description%",
  "engines": {
    "textus": ">=1.4.3"
  },
  "platforms": [
    "desktop",
    "ios"
  ],
  "main": "host.js",
  "permissions": [
    "editor.read",
    "files.write"
  ],
  "contributes": {
    "commands": [
      {
        "command": "luckylew23.markmap.open",
        "title": "%command.open%"
      }
    ],
    "menus": {
      "app/plugins": [
        {
          "command": "luckylew23.markmap.open"
        }
      ],
      "editor/context": [
        {
          "command": "luckylew23.markmap.open",
          "when": "documentOpen"
        }
      ]
    },
    "sidebarTabs": [
      {
        "icon": "tab.svg",
        "id": "luckylew23.markmap.panel",
        "title": "%panel.title%",
        "type": "webview"
      }
    ],
    "views": [
      {
        "id": "luckylew23.markmap.view",
        "title": "%view.title%",
        "type": "webview"
      }
    ]
  },
  "l10n": {
    "en": {
      "allView": "Whole map",
      "collapseChildren": "Collapse children",
      "command.open": "Open Mind Map",
      "defaultName": "Mind Map",
      "description": "Draws the whole note as a mind map: open it in a tab or the sidebar to see the full picture, pan and zoom (mouse wheel or two-finger pinch), click a node to jump back to its line, and export the map as an SVG file next to the note.",
      "empty": "No headings or lists in this note yet.",
      "expandChildren": "Expand children",
      "exportFailed": "Couldn't export the image: {0}",
      "exportImage": "Export image",
      "exported": "Image exported: {0}",
      "jumpFailed": "Couldn't jump: {0}",
      "levels": "Levels",
      "name": "Whole-Note Mind Map",
      "nextToNote": "next to the note",
      "noFolder": "No folder is open, so there is nowhere to save the image.",
      "noNote": "No note is open.",
      "notDrawn": "The map isn't drawn yet.",
      "note": "Note",
      "openTab": "Open the whole map in a tab",
      "pageFailed": "Couldn't read the page: {0}",
      "panel.title": "Mind Map",
      "panelPageFailed": "Couldn't read the mind map page: {0}",
      "renderFailed": "Couldn't draw the map: {0}",
      "saveImage": "Save this map as an image next to the note",
      "tabFailed": "Couldn't open the tab: {0}",
      "view.title": "Mind Map",
      "zoomIn": "Zoom in",
      "zoomOut": "Zoom out"
    },
    "zh": {
      "allView": "全图",
      "collapseChildren": "收起子节点",
      "command.open": "打开思维导图",
      "defaultName": "思维导图",
      "description": "把当前笔记整篇画成思维导图：直接在标签页里看全图，可以缩放（滚轮、双指捏合）、抓着鼠标拖动，点节点跳回笔记的那一行，还能把图导出成图片存在笔记旁边。",
      "empty": "这篇笔记里还没有标题或列表。",
      "expandChildren": "展开子节点",
      "exportFailed": "导出不了图片：{0}",
      "exportImage": "导出图片",
      "exported": "图片已导出：{0}",
      "jumpFailed": "跳不过去：{0}",
      "levels": "展示层级",
      "name": "整篇思维导图",
      "nextToNote": "笔记旁边",
      "noFolder": "没有打开文件夹，图片没地方存。",
      "noNote": "没有打开的笔记。",
      "notDrawn": "这张图还没画好。",
      "note": "笔记",
      "openTab": "在新标签页里看整张图",
      "pageFailed": "页面读不出来：{0}",
      "panel.title": "思维导图",
      "panelPageFailed": "思维导图页面读不出来：{0}",
      "renderFailed": "导图画不出来：{0}",
      "saveImage": "把这张图存成图片，放在笔记旁边",
      "tabFailed": "标签页打不开：{0}",
      "view.title": "思维导图",
      "zoomIn": "放大",
      "zoomOut": "缩小"
    }
  }
}
